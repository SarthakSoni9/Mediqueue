rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function staffProfilePath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function staffEmailProfilePath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }

    function isStaffMember() {
      return isAuthenticated()
        && (
          (exists(staffProfilePath())
            && get(staffProfilePath()).data.role in ['staff', 'doctor', 'admin'])
          || (request.auth.token.email is string
            && exists(staffEmailProfilePath())
            && get(staffEmailProfilePath()).data.role in ['staff', 'doctor', 'admin'])
        );
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          (exists(staffProfilePath()) && get(staffProfilePath()).data.role == 'admin')
          || (request.auth.token.email is string
            && exists(staffEmailProfilePath())
            && get(staffEmailProfilePath()).data.role == 'admin')
        );
    }

    function isDoctor() {
      return isAuthenticated()
        && (
          (exists(staffProfilePath()) && get(staffProfilePath()).data.role == 'doctor')
          || (request.auth.token.email is string
            && exists(staffEmailProfilePath())
            && get(staffEmailProfilePath()).data.role == 'doctor')
        );
    }

    // Staff profiles are private; users may read their own profile and admins may manage the directory.
    match /staff/{staffId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == staffId || request.auth.token.email == staffId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Doctors: Public read for Kiosk displays & directory; status update for authorized doctors/admins
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isStaffMember() || isDoctor() || isAdmin();
    }

    // Announcements: Public read for TV displays; write allowed only for administrative staff
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Queue records contain identifying and triage details; patients may only read their own records.
    match /patients/{patientId} {
      allow read: if isStaffMember() || isDoctor()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isStaffMember() || isDoctor()
        || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isStaffMember() || isDoctor() || isAdmin();
    }

    // Patient User Profiles: only the owner and authorized clinical staff may read.
    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId)
        || isStaffMember() || isDoctor();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Prescriptions: patients can read only documents linked to their own UHID.
    match /prescriptions/{prescriptionId} {
      allow read: if isDoctor() || isStaffMember()
        || (isAuthenticated()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && resource.data.patientUhid == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uhid);
      allow write: if isDoctor();
    }

    // Consultations: Strictly clinical consultation notes; writable ONLY by doctor
    match /consultations/{consultationId} {
      allow read: if isDoctor() || isAdmin() || isStaffMember();
      allow write: if isDoctor();
    }

    // Reschedule Audits: Only administrative write/read
    match /reschedule_audits/{auditId} {
      allow read: if isStaffMember() || isAdmin();
      allow write: if isStaffMember() || isAdmin();
    }

    // Wheelchair requests: Public request creation; staff updates
    match /wheelchairs/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Deny access to collections without an explicit rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
